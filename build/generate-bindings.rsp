--file
libghostty/include/ghostty/vt.h
--namespace
Ghostty.Vt.Native
--libraryPath
libghostty-vt
--methodClassName
NativeMethods
--output
src/Ghostty.Vt/Native/NativeMethods.cs
--language
c
--config
generate-macro-bindings
--config
latest-codegen
--config
generate-helper-types
--with-access-specifier
*=public
--exclude
GHOSTTY_VT_H
--remap
GhosttyTerminal=nint
--remap
GhosttyRenderState=nint
--remap
GhosttyFormatter=nint
--remap
GhosttyKeyEncoder=nint
--remap
GhosttyMouseEncoder=nint
--remap
GhosttyOscParser=nint
--remap
GhosttySgrParser=nint
--remap
GhosttyKittyGraphics=nint
--remap
GhosttyKittyGraphicsImage=nint
--remap
GhosttyKittyGraphicsPlacementIterator=nint
--remap
GhosttyRenderStateRowIterator=nint
--remap
GhosttyRenderStateRowCells=nint
--additional
-DGHOSTTY_EXPORT=
--additional
-D_WIN64
--additional
-D_MSC_VER=1940
--additional
"-DSSIZE_T=long long"
