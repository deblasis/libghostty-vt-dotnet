<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ghostty.Vt</RootNamespace>
    <AssemblyName>Ghostty.Vt</AssemblyName>
    <AotCompatible>true</AotCompatible>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.0.0-dev</Version>

    <!-- Package identity -->
    <PackageId>DeBlasis.GhosttyVt</PackageId>
    <Title>DeBlasis.GhosttyVt — unofficial .NET bindings for libghostty-vt</Title>
    <Description>Unofficial .NET bindings for libghostty-vt — the standalone VT parser from the Ghostty terminal emulator. Parse VT escape sequences, inspect the terminal grid, and encode keyboard/mouse input from any .NET application. Community port; not affiliated with the Ghostty project.</Description>
    <Authors>Alessandro De Blasis</Authors>
    <Company>Alessandro De Blasis</Company>
    <Copyright>Copyright (c) 2026 Alessandro De Blasis</Copyright>
    <PackageTags>terminal;vt;vt100;vt220;ansi;escape-sequences;ghostty;terminal-emulator;parser;pty;conpty;console</PackageTags>

    <!-- Licensing -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Repository + project metadata -->
    <PackageProjectUrl>https://github.com/deblasis/libghostty-vt-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/deblasis/libghostty-vt-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- README shown on nuget.org -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols + SourceLink: lets consumers step into our source when debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Deterministic builds on CI (GitHub Actions sets GITHUB_ACTIONS=true) -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ghostty.Vt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SourceLink: embeds repo URL + commit so debuggers can fetch our .cs files -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the README for display on nuget.org -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Native runtimes are packed and copied by two separate item groups.

    Packing takes the whole tree. Pack="true" + PackagePath="runtimes/" lets
    NuGet append the glob's RecursiveDir automatically, producing
    runtimes/<rid>/native/<file> in the .nupkg. (Repeating %(RecursiveDir) in
    PackagePath would double it.) A package is how one artifact carries every
    platform's native library, so every staged RID must be packed.

    Copy-to-output takes exactly one RID: the one being published when
    RuntimeIdentifier is set, otherwise the host RID. Flattening every staged
    RID next to the assembly makes `dotnet publish -r win-x64` fail with
    NETSDK1152 once both Windows trees are present, because win-x64 and
    win-arm64 each contain ghostty-vt.dll. A plain build or test copies the
    host's native so local P/Invoke keeps working.

    Globs are anchored via $(MSBuildThisFileDirectory) so path resolution does
    not depend on the invoking working directory — this matters on CI where
    `dotnet pack` is invoked from the repo root. An empty runtimes/ tree
    (local dev without build-native) produces empty item lists and the project
    still builds; it just cannot produce a usable pack.
  -->
  <PropertyGroup>
    <NativeCopyRid Condition="'$(NativeCopyRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NativeCopyRid>
    <NativeCopyRid Condition="'$(NativeCopyRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</NativeCopyRid>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../runtimes/**/*"
          Pack="true"
          PackagePath="runtimes/" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativeCopyRid)' != ''">
    <None Include="$(MSBuildThisFileDirectory)../../runtimes/$(NativeCopyRid)/native/*"
          CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    NuGet builds the .snupkg by taking every packed file whose extension is
    .pdb, and there is no item metadata that says "main package only". The
    native PDBs must stay in the .nupkg (they are what a debugger loads beside
    the DLL) but nuget.org's symbol server accepts only managed Portable PDBs;
    an MSF native PDB makes the symbol push fail validation asynchronously,
    long after the job went green. So the SDK packs them, and this target
    removes the runtimes/ entries from the symbol package before it leaves the
    build. The managed Portable PDB stays. The match treats backslashes as
    separators and ignores case, so a differently spelled native entry is
    removed as well.

    check-snupkg.py asserts the resulting shape, and its self-test proves the
    checker rejects a symbol package that still carries native PDBs.
  -->
  <UsingTask TaskName="RemoveNativePdbsFromSymbolPackage"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SymbolPackage ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!File.Exists(SymbolPackage)) return true;
        using (var archive = ZipFile.Open(SymbolPackage, ZipArchiveMode.Update))
        {
            var native = archive.Entries
                .Where(e => e.FullName.Replace('\\', '/')
                                .StartsWith("runtimes/", StringComparison.OrdinalIgnoreCase)
                            && e.FullName.EndsWith(".pdb", StringComparison.OrdinalIgnoreCase))
                .ToList();
            foreach (var entry in native)
            {
                entry.Delete();
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="TrimNativePdbsFromSymbolPackage"
          AfterTargets="Pack"
          Condition="'$(IncludeSymbols)' == 'true' and '$(SymbolPackageFormat)' == 'snupkg'">
    <RemoveNativePdbsFromSymbolPackage
        SymbolPackage="$(PackageOutputAbsolutePath)/$(PackageId).$(PackageVersion).snupkg" />
  </Target>
</Project>
