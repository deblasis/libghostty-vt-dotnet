<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ghostty.Vt</RootNamespace>
    <AssemblyName>Ghostty.Vt</AssemblyName>
    <AotCompatible>true</AotCompatible>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.0.0-dev</Version>

    <!-- Package identity -->
    <PackageId>DeBlasis.GhosttyVt</PackageId>
    <Title>DeBlasis.GhosttyVt — unofficial .NET bindings for libghostty-vt</Title>
    <Description>Unofficial .NET bindings for libghostty-vt — the standalone VT parser from the Ghostty terminal emulator. Parse VT escape sequences, inspect the terminal grid, and encode keyboard/mouse input from any .NET application. Community port; not affiliated with the Ghostty project.</Description>
    <Authors>Alessandro De Blasis</Authors>
    <Company>Alessandro De Blasis</Company>
    <Copyright>Copyright (c) 2026 Alessandro De Blasis</Copyright>
    <PackageTags>terminal;vt;vt100;vt220;ansi;escape-sequences;ghostty;terminal-emulator;parser;pty;conpty;console</PackageTags>

    <!-- Licensing -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Repository + project metadata -->
    <PackageProjectUrl>https://github.com/deblasis/libghostty-vt-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/deblasis/libghostty-vt-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- README shown on nuget.org -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols + SourceLink: lets consumers step into our source when debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Deterministic builds on CI (GitHub Actions sets GITHUB_ACTIONS=true) -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ghostty.Vt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SourceLink: embeds repo URL + commit so debuggers can fetch our .cs files -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the README for display on nuget.org -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\runtimes\win-x64\native\ghostty-vt.dll"
          Pack="true" PackagePath="runtimes\win-x64\native\"
          Condition="Exists('..\..\runtimes\win-x64\native\ghostty-vt.dll')" />
    <None Include="..\..\runtimes\linux-x64\native\libghostty-vt.so"
          Pack="true" PackagePath="runtimes\linux-x64\native\"
          Condition="Exists('..\..\runtimes\linux-x64\native\libghostty-vt.so')" />
    <None Include="..\..\runtimes\osx-arm64\native\libghostty-vt.dylib"
          Pack="true" PackagePath="runtimes\osx-arm64\native\"
          Condition="Exists('..\..\runtimes\osx-arm64\native\libghostty-vt.dylib')" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\runtimes\win-x64\native\ghostty-vt.dll"
          Link="ghostty-vt.dll"
          CopyToOutputDirectory="PreserveNewest"
          Pack="false"
          Condition="Exists('..\..\runtimes\win-x64\native\ghostty-vt.dll')" />
    <Content Include="..\..\runtimes\linux-x64\native\libghostty-vt.so"
          Link="libghostty-vt.so"
          CopyToOutputDirectory="PreserveNewest"
          Pack="false"
          Condition="Exists('..\..\runtimes\linux-x64\native\libghostty-vt.so')" />
    <Content Include="..\..\runtimes\osx-arm64\native\libghostty-vt.dylib"
          Link="libghostty-vt.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Pack="false"
          Condition="Exists('..\..\runtimes\osx-arm64\native\libghostty-vt.dylib')" />
  </ItemGroup>
</Project>
