<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ghostty.Vt</RootNamespace>
    <AssemblyName>Ghostty.Vt</AssemblyName>
    <AotCompatible>true</AotCompatible>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.0.0-dev</Version>

    <!-- Package identity -->
    <PackageId>DeBlasis.GhosttyVt</PackageId>
    <Title>DeBlasis.GhosttyVt — unofficial .NET bindings for libghostty-vt</Title>
    <Description>Unofficial .NET bindings for libghostty-vt — the standalone VT parser from the Ghostty terminal emulator. Parse VT escape sequences, inspect the terminal grid, and encode keyboard/mouse input from any .NET application. Community port; not affiliated with the Ghostty project.</Description>
    <Authors>Alessandro De Blasis</Authors>
    <Company>Alessandro De Blasis</Company>
    <Copyright>Copyright (c) 2026 Alessandro De Blasis</Copyright>
    <PackageTags>terminal;vt;vt100;vt220;ansi;escape-sequences;ghostty;terminal-emulator;parser;pty;conpty;console</PackageTags>

    <!-- Licensing -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Repository + project metadata -->
    <PackageProjectUrl>https://github.com/deblasis/libghostty-vt-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/deblasis/libghostty-vt-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- README shown on nuget.org -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols + SourceLink: lets consumers step into our source when debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Deterministic builds on CI (GitHub Actions sets GITHUB_ACTIONS=true) -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ghostty.Vt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SourceLink: embeds repo URL + commit so debuggers can fetch our .cs files -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the README for display on nuget.org -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Native runtimes. A single glob handles both packing and copy-to-output:
    - Pack="true" + PackagePath="runtimes/" lets NuGet append the glob's
      RecursiveDir automatically, producing runtimes/<rid>/native/<file> in
      the .nupkg. (Repeating %(RecursiveDir) in PackagePath would double it.)
    - CopyToOutputDirectory + Link="%(Filename)%(Extension)" copies each file
      next to the built assembly (for local P/Invoke in dev and tests).
    Glob is anchored via $(MSBuildThisFileDirectory) so path resolution does
    not depend on the invoking working directory — this matters on CI where
    `dotnet pack` is invoked from the repo root. An empty runtimes/ tree
    (local dev without build-native) produces an empty item list and the
    project still builds; it just cannot produce a usable pack.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../runtimes/**/*"
          Pack="true"
          PackagePath="runtimes/"
          CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
