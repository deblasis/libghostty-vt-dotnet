<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      <clear/> removes every inherited source (machine-level, user-level,
      nuget.org) so we control exactly what is in scope. nuget.org is added
      back explicitly below — but packageSourceMapping ensures
      DeBlasis.GhosttyVt can ONLY come from the local feed. That is the
      load-bearing guarantee: a real consumer's test must validate the
      packed artifact, never a silently-resolved nuget.org copy.
    -->
    <clear />
    <add key="local-artifacts" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!--
      DeBlasis.GhosttyVt is pinned to the local feed only. If the local
      feed is missing or the package isn't there, restore will fail loudly
      — it will NOT fall back to nuget.org even though nuget.org is now
      listed as a source. Everything else (test SDK, xunit, transitive
      dependencies) resolves from nuget.org.
    -->
    <packageSource key="local-artifacts">
      <package pattern="DeBlasis.GhosttyVt" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
