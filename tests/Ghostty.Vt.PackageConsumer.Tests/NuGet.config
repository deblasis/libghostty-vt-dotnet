<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      <clear/> is load-bearing: it removes every inherited source
      (machine-level, user-level, nuget.org). If the local feed cannot
      satisfy DeBlasis.GhosttyVt, restore MUST fail loudly instead of
      silently pulling from nuget.org and validating the wrong package.
    -->
    <clear />
    <add key="local-artifacts" value="../../artifacts" />
  </packageSources>
</configuration>
