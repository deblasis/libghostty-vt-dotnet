<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      <clear/> removes every inherited source (machine-level, user-level,
      nuget.org) so we control exactly what is in scope. nuget.org is added
      back explicitly below — the enforcement that DeBlasis.GhosttyVt can
      never come from nuget.org is applied per package ID via
      packageSourceMapping, not by omitting nuget.org as a source.
    -->
    <clear />
    <add key="local-artifacts" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!--
      DeBlasis.GhosttyVt and any future sibling ID (DeBlasis.GhosttyVt.*)
      are pinned to the local feed only. If the local feed is missing or
      the package isn't there, restore fails loudly — it will NOT fall
      back to nuget.org even though nuget.org is listed as a source.
      Everything else (test SDK, xunit, transitive dependencies) resolves
      from nuget.org. Requires NuGet 6.0+.
    -->
    <packageSource key="local-artifacts">
      <package pattern="DeBlasis.GhosttyVt" />
      <package pattern="DeBlasis.GhosttyVt.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
