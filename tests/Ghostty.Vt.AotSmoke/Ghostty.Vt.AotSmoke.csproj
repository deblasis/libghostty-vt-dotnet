<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ghostty.Vt\Ghostty.Vt.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\runtimes\linux-x64\native\libghostty-vt.so"
          Link="libghostty-vt.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\runtimes\linux-x64\native\libghostty-vt.so')" />
  </ItemGroup>
</Project>
